# Copy this file to .env.home-server on the Surface Pro.
# Keep the real file out of Git.
ONGI_POSTGRES_PASSWORD=replace-with-a-long-random-password

ONGI_ALLOWED_ORIGINS=https://ongi.greengroove.app
ONGI_BACKEND_BIND_ADDRESS=127.0.0.1
ONGI_BACKEND_PORT=8080
ONGI_BACKEND_MEMORY_LIMIT=2g
ONGI_POSTGRES_MEMORY_LIMIT=768m
ONGI_JAVA_TOOL_OPTIONS=-Xms256m -Xmx1g -XX:+ExitOnOutOfMemoryError
ONGI_DB_POOL_SIZE=20
ONGI_ROOM_ACTIVE_LIFETIME=12h
ONGI_TOMBSTONE_RETENTION=24h
ONGI_JOIN_ATTEMPTS_PER_CODE_PER_MINUTE=30
