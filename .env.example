# Local development only. Production secrets belong in the deployment platform.
ONGI_POSTGRES_DB=ongi
ONGI_POSTGRES_USER=ongi
ONGI_POSTGRES_PASSWORD=replace-with-a-local-password

DB_URL=jdbc:postgresql://localhost:5432/ongi
DB_USERNAME=ongi
DB_PASSWORD=replace-with-a-local-password

ONGI_ALLOWED_ORIGINS=http://localhost:5173
ONGI_SECURE_COOKIE=false
ONGI_ROOM_ACTIVE_LIFETIME=12h
ONGI_TOMBSTONE_RETENTION=24h
ONGI_JOIN_ATTEMPTS_PER_MINUTE=30
ONGI_JOIN_ATTEMPTS_PER_CODE_PER_MINUTE=15

# Frontend build-time API origin
VITE_API_BASE_URL=http://localhost:8080
